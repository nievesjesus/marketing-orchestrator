{
  "name": "@codeame/marketing-images",
  "version": "0.1.0",
  "description": "MCP server for social-media graphics: AI image generation (Gemini, fal.ai, Leonardo) and a deterministic post composer. Runs locally over stdio or as an HTTP server.",
  "license": "MIT",
  "author": "Codeame, LLC",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "marketing",
    "social-media",
    "image-generation",
    "postiz"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nievesjesus/marketing-orchestrator.git",
    "directory": "servers/marketing-images"
  },
  "homepage": "https://github.com/nievesjesus/marketing-orchestrator/tree/main/servers/marketing-images#readme",
  "bugs": {
    "url": "https://github.com/nievesjesus/marketing-orchestrator/issues"
  },
  "bin": {
    "marketing-images": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "NODE_ENV=development NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --env-file-if-exists=.env src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/render/templates/starters','dist/render/templates/starters',{recursive:true})\"",
    "prepack": "npm run build",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "typecheck": "tsc --noEmit",
    "readme:assets": "tsx scripts/readme-assets.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@resvg/resvg-js": "2.6.2",
    "opentype.js": "2.0.0",
    "parse5": "8.0.1",
    "satori": "0.47.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}

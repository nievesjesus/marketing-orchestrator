{
  "name": "marketing-images",
  "version": "0.1.0",
  "private": true,
  "description": "Portable MCP server (Streamable HTTP): image generation and deterministic post-graphic composer for the marketing-orchestrator plugin.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "NODE_ENV=development NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@resvg/resvg-js": "2.6.2",
    "opentype.js": "2.0.0",
    "satori": "0.47.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}

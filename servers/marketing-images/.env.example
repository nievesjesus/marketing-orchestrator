# marketing-images: configuration. Copy to `.env` (never commit it) or set these in your host
# (Coolify -> Environment Variables). Names only: fill in your own values.

# --- Secrets ---------------------------------------------------------------------------
# One entry per person: name:token,name:token  (the name keys quota and logs).
# Generate each token with: openssl rand -hex 24
ACCESS_TOKENS=
# Provider keys. A missing key just marks that provider unavailable.
GEMINI_API_KEY=
FAL_KEY=
LEONARDO_API_KEY=

# --- Public settings (defaults shown; uncomment to change) ----------------------------
# Public base URL used in the image links the server returns (no trailing slash).
# PUBLIC_BASE_URL=http://localhost:8080
# Where the SQLite ledger and the stored images live (mount a volume here in Docker).
# DATA_DIR=/data
# Images older than this are deleted by the hourly sweep.
# RETENTION_DAYS=30
# Per-user daily caps (UTC day). Renders are the free compose_post calls.
# DAILY_IMAGE_LIMIT=30
# DAILY_USD_LIMIT=3.00
# DAILY_RENDER_LIMIT=200
# Longest a tool call waits for a provider before returning a job id.
# SYNC_WAIT_MS=60000
# PORT=8080
# HOST=0.0.0.0           # defaults to 127.0.0.1 when NODE_ENV=development
# LOG_LEVEL=info         # debug | info | warn | error
# NODE_ENV=production    # development/test also allow http://localhost image links

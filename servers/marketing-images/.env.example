# marketing-images: configuration. Every variable is listed here, names only: fill in your own values.
#
# Where to put it
#   Local (stdio, `npx -y @codeame/marketing-images`):  ~/.config/marketing-images/.env  (or $XDG_CONFIG_HOME/marketing-images/.env,
#                                                        or any path given with --env). Keep it private: chmod 600 <file>
#   Server (HTTP / Docker / Coolify):                    a `.env` next to docker-compose.yml, or the host's environment variables.
# Variables already set in the real environment win over this file; an empty variable counts as unset.
# Never commit a filled-in copy of this file.

# --- Image providers (a missing key just marks that provider unavailable) -------------
GEMINI_API_KEY=
FAL_KEY=
LEONARDO_API_KEY=

# --- Direct upload to Postiz (optional) --------------------------------------------------
# Set BOTH to upload your finished graphics to Postiz as well; the tool results then carry
# `postiz.path`, which the agent uses directly as the Postiz attachment (no uploadFromUrlTool needed).
# POSTIZ_URL accepts the app URL or the API base; it is normalized to the Public API base:
#   Postiz Cloud   https://api.postiz.com   (or https://platform.postiz.com)   -> https://api.postiz.com/public/v1
#   Self-hosted    https://postiz.example.com  (or .../api, or .../api/public/v1) -> https://postiz.example.com/api/public/v1
# POSTIZ_URL=
# POSTIZ_API_KEY=            # Postiz > Settings > Public API. Sent as the raw `Authorization` header.
# Automatic upload (default true when both are set): compose_post, compose_custom and compose_carousel upload the
# FINAL graphic by themselves; generate_image, edit_image and get_job do NOT upload unless the call passes
# `upload_to_postiz: true` (their pictures are usually backgrounds that get a headline later). `false` here turns
# every automatic upload off. Any call can override with `upload_to_postiz` (true or false).
# POSTIZ_AUTO_UPLOAD=true
# HTTP mode only: the Postiz key belongs to ONE account, so it is ignored unless you confirm the server is single-tenant.
# POSTIZ_ALLOW_IN_HTTP=false

# --- Local (stdio) mode ----------------------------------------------------------------------
# Where the database (brands, templates, quota) and the images live. Default: ~/.marketing-images
# (stdio) or /data (HTTP). Same as --data-dir. MARKETING_IMAGES_HOME is the default for DATA_DIR.
# DATA_DIR=
# MARKETING_IMAGES_HOME=
# Extra folders (absolute paths or ~/..., separated by commas) from which your own local `file://` photos
# may be used as backgrounds, logos or edit sources. Images made by this server are always allowed.
# Example: LOCAL_IMAGE_DIRS=~/Pictures/marketing,/Volumes/Photos/brand
# LOCAL_IMAGE_DIRS=

# --- HTTP mode (`--http`, Docker) -------------------------------------------------------
# One entry per person: name:token,name:token  (the name keys quota and logs).
# Generate each token with: openssl rand -hex 24
ACCESS_TOKENS=
# Base URL of the image links the server returns (no trailing slash). In stdio mode, links are file:// URLs
# unless this is set (only useful if something serves DATA_DIR/images at <base>/i/).
# PUBLIC_BASE_URL=http://localhost:8080
# PORT=8080                  # same as --port
# HOST=0.0.0.0               # the container default; `marketing-images --http` binds 127.0.0.1 unless set
# NODE_ENV=production        # development/test also allow http://localhost image links and bind 127.0.0.1

# --- Limits and housekeeping (both modes) -------------------------------------------------
# Images older than this are deleted by the hourly sweep (Postiz keeps its own copy).
# RETENTION_DAYS=30
# Per-user daily caps (UTC day). Renders are the free compose_* calls.
# DAILY_IMAGE_LIMIT=30
# DAILY_USD_LIMIT=3.00
# DAILY_RENDER_LIMIT=200
# Longest a tool call waits for a provider before returning a job id.
# SYNC_WAIT_MS=60000
# LOG_LEVEL=info             # debug | info | warn | error (stdio: logs go to stderr, never stdout)
